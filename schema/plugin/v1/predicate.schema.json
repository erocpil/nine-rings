        },
        {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "all": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/P4"
                  },
                  "minItems": 1,
                  "maxItems": 8
                }
              },
              "required": [
                "all"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "any": {
