            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "any": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/P5"
                  },
                  "minItems": 1,
                  "maxItems": 8
                }
              },
              "required": [
